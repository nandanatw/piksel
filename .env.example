# Never commit real values to this file. Set all secrets through your host's secret manager.
NODE_ENV=production
PORT=3456
TRUST_PROXY=true
RENOISE_CLI_PATH=./renoise-cli
JWT_SECRET=replace-with-a-random-64-character-secret
TOTP_SECRET=replace-with-base64-totp-secret
ADMIN_PASSWORD=replace-with-a-long-unique-password
BASE_URL=https://piksel.my.id
PUBLIC_APP_URL=https://app.piksel.my.id
DATABASE_URL=postgresql://user:password@host:5432/piksel
DATABASE_SSL=true
DB_POOL_MAX=20

# API protection and capacity. Tune these after observing real traffic.
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_15_MINUTES=10
GENERATION_RATE_LIMIT_PER_MINUTE=6
MAX_UPLOAD_BYTES=10485760
MAX_CONCURRENT_GENERATIONS=4
MAX_CONCURRENT_PER_KEY=2
POOL_BALANCE_REFRESH_MS=30000
MAX_KEY_RETRIES=2
GENERATION_TOTAL_TIMEOUT_MS=720000
MAX_QUEUED_GENERATIONS=100
MAX_USER_GENERATIONS=3
CREDIT_REFRESH_INTERVAL_MS=60000

# Required integrations
GMAIL_USER=
GMAIL_APP_PASSWORD=
BREVO_API_KEY=
BREVO_SENDER=
PAKASIR_API_KEY=
PAKASIR_PROJECT=
PAKASIR_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
PASSWORD_RESET_SUBMIT_LIMIT_PER_15_MINUTES=5
