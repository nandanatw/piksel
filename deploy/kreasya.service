# Kreasya — systemd unit (isolated from other services on this VPS).
# Install:
#   sudo cp deploy/kreasya.service /etc/systemd/system/kreasya.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kreasya

[Unit]
Description=Kreasya AI image generation API
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/kreasya
Environment=NODE_ENV=production
Environment=TRUST_PROXY=true
Environment=MAX_CONCURRENT_GENERATIONS=2
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

# Allow the app to drain in-flight image generations on stop/restart before
# systemd force-kills it. Must exceed the app's SHUTDOWN_WAIT_MS (90s).
TimeoutStopSec=120
KillSignal=SIGTERM

# 2GB VPS: cap memory so a runaway Chromium/Node cannot OOM the box
# and take down other sites (e.g. bandelbanget.shop). Increase only after
# adding swap and observing real usage.
MemoryHigh=768M
MemoryMax=1024M

NoNewPrivileges=true

# Secrets live in /opt/kreasya/.env and are loaded by dotenv at startup.
# Do NOT use EnvironmentFile= here: systemd cannot parse values containing
# spaces (e.g. the Gmail app password), while dotenv can.

[Install]
WantedBy=multi-user.target
